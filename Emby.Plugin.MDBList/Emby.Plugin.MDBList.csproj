<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Emby.Plugin.MDBList</RootNamespace>
    <AssemblyName>Emby.Plugin.MDBList</AssemblyName>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- English is the neutral (default) resource; Resources.zh-Hans.resx is the
         Simplified Chinese satellite. It is named zh-Hans (not zh-CN) on
         purpose: Resource.Embedder discovers satellites by enumerating
         CultureInfo.GetCultures(), and on modern .NET/ICU that list does NOT
         contain "zh-CN" (it contains "zh-Hans"/"zh-Hans-CN"). A zh-CN folder is
         therefore silently skipped ("Nothing to embed!"). At runtime .NET's
         ResourceManager walks the parent chain zh-CN -> zh-Hans -> zh, so the
         zh-Hans satellite also serves zh-CN requests. -->
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Emby plugins ship as a single DLL and cannot load satellite-assembly
         subfolders, so the per-language .resources compiled from
         Resources.zh-Hans.resx are embedded into the main DLL instead. Emby's
         own Plugin UI localization guidance requires this package. -->
    <PackageReference Include="Resource.Embedder" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Extracted from the pinned emby/embyserver Docker image, see dev/docker-compose.yml
         and the Phase 0 notes in the plan. No current NuGet packages exist for these. -->
    <EmbySystemPath>$(MSBuildThisFileDirectory)../dev/system</EmbySystemPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(EmbySystemPath)/MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(EmbySystemPath)/MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(EmbySystemPath)/MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Emby.Web.GenericEdit">
      <HintPath>$(EmbySystemPath)/Emby.Web.GenericEdit.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Emby.Plugin.MDBList.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="ThumbImage.png" />
    <EmbeddedResource Include="ThumbImage.png" />
  </ItemGroup>

</Project>
