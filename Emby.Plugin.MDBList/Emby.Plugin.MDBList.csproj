<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Emby.Plugin.MDBList</RootNamespace>
    <AssemblyName>Emby.Plugin.MDBList</AssemblyName>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- English is the neutral (default) resource. It is named zh-Hans (not
         zh-CN) on purpose: at runtime .NET walks the parent chain
         zh-CN -> zh-Hans -> zh, and zh-Hans is the culture name that appears in
         CultureInfo.GetCultures(). -->
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Emby plugins ship as a single DLL and cannot load satellite-assembly
         subfolders. Instead of a satellite assembly, compile the Simplified
         Chinese resource set straight into the main DLL: WithCulture=false
         keeps it out of the satellite-generation path, and LogicalName gives it
         the name ResourceManager looks up for zh-Hans.

         This replaces the Resource.Embedder package, which cannot run on Linux
         build hosts: its 2.2.0 task turns Assembly.CodeBase's "file:///home/..."
         into "home\\..." (Replace("/", "\\")), so code injection fails there. -->
    <EmbeddedResource Update="Resources.zh-Hans.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>Emby.Plugin.MDBList.Resources.zh-Hans.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <!-- Extracted from the pinned emby/embyserver Docker image, see dev/docker-compose.yml
         and the Phase 0 notes in the plan. No current NuGet packages exist for these. -->
    <EmbySystemPath>$(MSBuildThisFileDirectory)../dev/system</EmbySystemPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(EmbySystemPath)/MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(EmbySystemPath)/MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(EmbySystemPath)/MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Emby.Web.GenericEdit">
      <HintPath>$(EmbySystemPath)/Emby.Web.GenericEdit.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Emby.Plugin.MDBList.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="ThumbImage.png" />
    <EmbeddedResource Include="ThumbImage.png" />
  </ItemGroup>

</Project>
